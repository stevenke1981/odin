on/feature-evidence.json')\ncheck('requirements_not_overstated', feature['status_summary'] == {'PASS': 0, 'PARTIAL': 38, 'NOT_RUN': 2})\n\nfor name in [validation_path, native, 'verification/native-inspections-release-final-command.json',\n             'verification/language-ide-final-baseline-03.json', args.sandbox, 'verification/sandbox-ide-review.json']:\n    blob = subprocess.check_output(['git', 'show', ':' + name], cwd=root)\n    check('staged_git_blob_matches_bound_file:' + name, hashlib.sha256(blob).hexdigest() == digest(name))\n\nresult = {'status': 'PASS' if all(c['status'] == 'PASS' for c in checks) else 'FAIL',\n    'scope': 'Actual cross-file source, binary, command exit, log, transcript, review and staged public artifact hash audit; this is not another execution of product tests.',\n    'completed_at_utc': datetime.datetime.now(datetime.UTC).isoformat(),\n    'argv': ['python', '-X', 'utf8', '.odin/verify_release_artifacts.py', '--sandbox', args.sandbox],\n    'checks': checks,\n    'checker_source': Path(__file__).read_text(encoding='utf-8')}\n(root / 'verification/sandbox-ide-artifact-bindings.json').write_text(json.dumps(result, ensure_ascii=False, indent=2) + '\\n', encoding='utf-8', newline='\\n')\nprint(json.dumps({'status': result['status'], 'bindings_checked': len(checks), 'failures': [c['name'] for c in checks if c['status'] == 'FAIL']}))\nraise SystemExit(0 if result['status'] == 'PASS' else 1)\n"
